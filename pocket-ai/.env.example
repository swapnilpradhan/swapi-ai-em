# Copy to .env and fill in. Never commit .env.

APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# --- Storage -----------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://pocket:pocket@localhost:5432/pocket_ai
# Local staging area for audio before it is pushed to Drive.
MEDIA_ROOT=./data/media

# --- Pocket API (source of recordings) -------------------------------------
# Create an API key in Pocket; it looks like pk_xxx.
POCKET_API_KEY=
POCKET_API_BASE_URL=https://api.heypocketai.com
# Shared secret for webhook signature verification. Without it the webhook
# endpoint rejects every delivery rather than trusting unauthenticated callers.
POCKET_WEBHOOK_SECRET=
POCKET_WEBHOOK_SIGNATURE_HEADER=X-Pocket-Signature
POCKET_WEBHOOK_TIMESTAMP_HEADER=X-Pocket-Timestamp
POCKET_WEBHOOK_TOLERANCE_SECONDS=300

# --- Google Drive ------------------------------------------------------------
# OAuth client from Google Cloud Console (Desktop or Web application type).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/drive/oauth/callback
# Root folder in the user's Drive that Pocket.ai Studio owns.
DRIVE_ROOT_FOLDER_NAME=Pocket.ai Studio

# --- LLM ---------------------------------------------------------------------
ANTHROPIC_API_KEY=
# Model routing. Deep reasoning vs. cheap high-volume passes.
LLM_MODEL_REASONING=claude-opus-5
LLM_MODEL_FAST=claude-haiku-4-5-20251001

# --- Speaker diarization -----------------------------------------------------
# HuggingFace token, required for pyannote speaker-diarization models.
HUGGINGFACE_TOKEN=
DIARIZATION_BACKEND=stub

# --- Vector store ------------------------------------------------------------
CHROMA_PERSIST_DIR=./data/chroma
