# Required: OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Redis Configuration
REDIS_URL=redis://localhost:6379

# Optional: OpenTelemetry Configuration
OTLP_ENDPOINT=http://localhost:4317

# Optional: Environment
ENVIRONMENT=development

# Optional: Logging Level
LOG_LEVEL=INFO

# Optional: Cache TTLs (in seconds)
DEFAULT_CACHE_TTL=3600
SESSION_CACHE_TTL=86400
AGENT_RESULT_TTL=1800

# Optional: Vector Database Configuration
CHROMA_HOST=localhost
CHROMA_PORT=8000

# Optional: Monitoring Configuration
METRICS_ENABLED=true
TRACING_ENABLED=true

# PostgreSQL Database
DATABASE_URL=postgresql+asyncpg://swapi:swapi_secret@localhost:5432/swapi_em

# Admin API Key
ADMIN_API_KEY=change_me_in_production
